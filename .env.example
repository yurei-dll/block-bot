MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=block-bot
MC_AUTH=offline
# MC_VERSION=1.21.4

BOT_DECISION_INTERVAL_MS=500
BOT_MIN_TASK_RUNTIME_MS=1000
BOT_SWITCH_MARGIN=10

# Enables operator-only in-game commands such as: !bb scan
# BOT_OPERATOR_USERNAME=YourMinecraftName
BOT_COMMAND_PREFIX=!bb
BOT_LOCATION_SCAN_RADIUS=16
BOT_LOCATION_SCAN_LIMIT=128
BOT_STATE_DIRECTORY=.block-bot
